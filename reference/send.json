{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Aurora SendCloud Email Send API"
  },
  "servers": [
    {
      "url": "https://api.aurorasendcloud.com"
    }
  ],
  "tags": [],
  "paths": {
    "/smsapi/send": {
      "post": {
        "summary": "New Endpoint",
        "description": "This is your first endpoint! Edit this page to start documenting your API.",
        "operationId": "get_new-endpoint",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "default": "200",
                      "description": "send result"
                    },
                    "message": {
                      "type": "string",
                      "default": "success",
                      "description": "success or fail message"
                    },
                    "info": {
                      "type": "object",
                      "properties": {
                        "successCount": {
                          "type": "integer",
                          "description": "success count"
                        },
                        "failedCount": {
                          "type": "integer",
                          "description": "failed count"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "properties": {},
                            "type": "object"
                          },
                          "description": "failed phone and reason"
                        },
                        "smsIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "success sms id list"
                        }
                      }
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "info"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "smsUser",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "smsUser"
          },
          {
            "in": "query",
            "name": "smsKey",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "templateId",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "template ID"
          },
          {
            "in": "query",
            "name": "phone",
            "schema": {
              "type": "string"
            },
            "description": "phone numbers of recipients, separated by commas; the amount cannot be more 2,000 each time. Contact list will be suggested when the recipients are more than 2000.",
            "required": true
          },
          {
            "in": "query",
            "name": "vars",
            "schema": {
              "type": "string",
              "default": "json string of substitution variable"
            }
          },
          {
            "in": "query",
            "name": "senderID",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sendRequestId",
            "schema": {
              "type": "string"
            },
            "description": "supports up to 128 characters, multiple requests with the same sendRequestId within 1 hour will only be processed for the first time"
          },
          {
            "in": "query",
            "name": "timestamp",
            "schema": {
              "type": "string"
            },
            "description": "UNIX timestamp"
          },
          {
            "in": "query",
            "name": "customArgs",
            "schema": {
              "type": "string"
            },
            "description": "The value is in JSON format, and the maximum character length is 128, for example: {\"key1\": \"value1\", \"key2\": \"Value2\"}"
          }
        ],
        "security": [
          {
            "smsUser": [],
            "smsKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "smsUser": {
        "type": "apiKey",
        "in": "query",
        "name": "smsUser"
      },
      "smsKey": {
        "type": "apiKey",
        "in": "query",
        "name": "smsKey"
      }
    }
  },
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  }
}